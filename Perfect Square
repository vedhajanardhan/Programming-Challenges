import java.util.Scanner;

public class L3_04_PerfectSquare {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        long n = sc.nextLong();

        if (n < 0) {
            System.out.println("Not a Perfect Square");
            sc.close();
            return;
        }

        long left = 0;
        long right = n;

        while (left <= right) {
            long mid = left + (right - left) / 2;
            long square = mid * mid;

            if (square == n) {
                System.out.println("Perfect Square");
                sc.close();
                return;
            } else if (square < n) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        System.out.println("Not a Perfect Square");

        sc.close();
    }
}
